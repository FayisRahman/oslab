//logout

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 28;

alias userSP R0;
userSP = SP;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias returnAddress R1;
returnAddress = ([PTBR + 2 * ((userSP-1)/512)] * 512 + ((userSP-1)%512));

if([SYSTEM_STATUS_TABLE + 1] != 2) then
    [returnAddress] = -1;
else
    //kill all
    multipush(R0,R1);
    R1 = KILL_ALL;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call PROCESS_MANAGER;
    multipop(R0,R1);

    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 4] = TERMINATED; //here [SYSTEM_STATUS_TABLE + 1] = 2

    [[PTBR + 16] * 512] = [[PTBR + 8] * 512 + 1]; // reset entry point

    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = 8 * 512;

    [PROCESS_TABLE + 1 * 16 + 4] = READY; //login shell

    [SYSTEM_STATUS_TABLE + 0] = 0; //curr_user_id

    multipush(R0,R1);
    call SCHEDULER;
    multipop(R0,R1);

    [returnAddress] = 0;
endif;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
ireturn;