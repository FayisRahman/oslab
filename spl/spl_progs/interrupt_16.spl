//newusr,remusr,setpwd,getuid,getuname

alias userSP R0;
userSP = SP;

alias sysCallNum R1;
sysCallNum = [([PTBR + 2 * (userSP-5)/512]) * 512 + ((userSP-5)%512)];

alias returnAddress R2;
returnAddress = [PTBR + 2 * (userSP-1)/512] * 512 + ((userSP-1)%512);

alias userName R3;
userName = [[PTBR + 2 * (userSP-4)/512] * 512 + ((userSP-4)%512)];

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = sysCallNum;

//newusr
if(sysCallNum == 22) then
    if([SYSTEM_STATUS_TABLE] != ROOT || [SYSTEM_STATUS_TABLE + 1] != 2) then
        [returnAddress] = -2;   
    else

        alias password R4;
        password = [([PTBR + 2 * ((userSP-3)/512)] * 512 + ((userSP-3)%512))];

        alias i R5;
        i = 0;
        while(i<MAX_USER_NUM) do
            if([USER_TABLE + 2 * i] == userName || [USER_TABLE + i * 2 + 0] == -1) then
                break;
            endif;
            i = i + 1;
        endwhile;

        if(i == MAX_USER_NUM ) then
            [returnAddress] = -3;

        else
            if([USER_TABLE + 2 *i] == userName) then
                [returnAddress] = -1;
            else
                alias encryptedPassword R6;
                encryptedPassword = password;
                encrypt encryptedPassword;

                [USER_TABLE + 2 * i] = userName;
                [USER_TABLE + 2 * i + 1] = encryptedPassword;

                [returnAddress] = 0;
            endif;
        endif;
    endif;
endif;

//remusr
if(sysCallNum == 23) then
    if([SYSTEM_STATUS_TABLE] != ROOT || [SYSTEM_STATUS_TABLE + 1] != 2) then
        [returnAddress] = -2;
    else
        if(userName == "root" || userName == "kernel") then
            [returnAddress] = -1;
        
        else
            alias userID R4;
            userID = 0;
            while(userID<MAX_USER_NUM) do
                if([USER_TABLE + 2 * userID] == userName) then
                    break;
                endif;
                userID = userID + 1;
            endwhile;

            if(userID == MAX_USER_NUM) then
                [returnAddress] = -1;
            else
                alias j R5;
                j=0;
                while(j<MAX_FILE_NUM) do
                    if([INODE_TABLE + j * 16 + 3] == userID) then
                        break;
                    endif;
                    j = j + 1;
                endwhile;
                if(j != MAX_FILE_NUM) then
                    [returnAddress] = -3;
                else
                    [USER_TABLE + 2 * userID] = -1;
                    [USER_TABLE + 2 * userID + 1] = -1;
                    [returnAddress] = 0;
                endif;
            endif;
        endif;
    endif;
endif;

//setpwd
if(sysCallNum == 24) then
    if([SYSTEM_STATUS_TABLE + 1] != 2) then
        [returnAddress] = -1;
    else
        alias i R4;
        i = 0;
        while(i<MAX_USER_NUM) do
            if([USER_TABLE + 2 * i] == userName) then
                break;
            endif;
            i = i + 1;
        endwhile;
        
        if(i == MAX_USER_NUM) then
            [returnAddress] = -2;
        else
            if([SYSTEM_STATUS_TABLE] != i && [SYSTEM_STATUS_TABLE] != ROOT) then //checking if someone elsse other than root is trynna change the passwd
                [returnAddress] = -1; 
            else
                print i;
                print userName;
                alias password R5;
                password = [([PTBR + 2 * ((userSP-3)/512)] * 512 + ((userSP-3)%512))];
                print password;
                alias encryptedPassword R6;
                encryptedPassword = password;
                encrypt encryptedPassword;
                [USER_TABLE + 2 * i + 1] = encryptedPassword;
                [returnAddress] = 0;
            endif;
        endif;
    endif;
endif;

//Getuname
if (sysCallNum == 25) then 
    alias userID R3;
    
    if (userID < 0 || userID > MAX_USER_NUM) then 
        [returnAddress] = -1;
    else
        if ([USER_TABLE + userID * 2 + 0] == -1) then 
            [returnAddress] = -1;
        else
            [returnAddress] = [USER_TABLE + userID * 2 + 0];
        endif;
    endif;
endif;

//getuid
if(sysCallNum == 26) then
    
    alias uid R4;
    uid = 0;
    while(uid<MAX_USER_NUM) do
        if([USER_TABLE + 2 * uid] == userName) then
            break;
        endif;
        uid = uid + 1;
    endwhile;

    if(uid == MAX_USER_NUM) then
        [returnAddress] = -1;
    else
        [returnAddress] = uid;
    endif;
    

endif;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;