//seek,open and close system calls

alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias syscall R1;
syscall = [([PTBR + 2 * ((userSP-5)/512)] * 512 + ((userSP-5)%512))];

alias returnAddress R2;
returnAddress = ([PTBR + 2 * ((userSP-1)/512)] * 512 + ((userSP-1)%512));

alias perProcessTable R3;
perProcessTable = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 + RESOURCE_TABLE_OFFSET;


//open
if(syscall == 2) then
    
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 2; //open syscall

    alias fileName R4;
    fileName = [([PTBR + 2 * ((userSP-4)/512)] * 512 + ((userSP-4)%512))];

    alias i R5;
    i = 0;
    while(i<8) do
        if([perProcessTable + i * 2] == -1) then
            break;
        endif;
        i = i + 1;
    endwhile;

    if(i == 16) then
        [returnAddress] = -3;
    else
        
        //calling open
        multipush(R1,R2,R3,R4,R5);
        R1 = 3;
        R2 = fileName;
        call FILE_MANAGER;
        multipop(R1,R2,R3,R4,R5);
        
        if(R0 < 0) then
            [returnAddress] = R0;
        else
            [perProcessTable + 2 * i] = FILE;
            [perProcessTable + 2 * i + 1] = R0;
            [returnAddress] = i;
        endif;
    endif;

endif;

//close
if(syscall == 3) then
    
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 3; //close syscall

    alias fd R4;
    fd = [([PTBR + 2 * ((userSP-4)/512)] * 512 + ((userSP-4)%512))];

    if( fd < 0 || fd > 7 ) then
        [returnAddress] = -1;
    endif;

    if([perProcessTable + 2 * fd] == -1 || [perProcessTable + 2 * fd] != FILE) then
        [returnAddress] = -1;
    endif;

    alias openFileTableEntry R5;
    openFileTableEntry = [perProcessTable + 2 * fd + 1];

    //calling close
    multipush(R1,R2,R3,R4,R5);
    R1 = 4;
    R2 = openFileTableEntry;
    call FILE_MANAGER;
    multipop(R1,R2,R3,R4,R5);

    [perProcessTable + 2 * fd] = -1;
    [perProcessTable + 2 * fd + 1] = -1;
  
    [returnAddress] = 0;

endif;

if(syscall == 6) then

    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 6;

    alias fileDescriptor R4;
    fileDescriptor = [([PTBR + 2 * ((userSP-4)/512)] * 512 + ((userSP-4)%512))];

    alias offset R5;
    offset = [([PTBR + 2 * ((userSP-3)/512)] * 512 + ((userSP-3)%512))];

    if(fileDescriptor < 0 || fileDescriptor > 7) then
        [returnAddress] = -1;
    else
        if([perProcessTable + fileDescriptor * 2 + 0] != FILE) then
            [returnAddress] = -1;
        else
            alias openFileTableEntry R6;
            openFileTableEntry = [perProcessTable + fileDescriptor * 2 + 1];

            alias inodeIndex R7;
            inodeIndex = [OPEN_FILE_TABLE + openFileTableEntry * 4 + 0];

            //acquiring the inode lock
            multipush(R0,R1,R2,R3,R4,R5,R6,R7);
            R1 = ACQUIRE_INODE;
            R2 = inodeIndex;
            R3 = [SYSTEM_STATUS_TABLE + 1];
            call RESOURCE_MANAGER;
            R9 = R0;
            multipop(R0,R1,R2,R3,R4,R5,R6,R7);

            alias fileSize R8;
            if(inodeIndex == INODE_ROOT) then
                fileSize = 480;
            else
    
               fileSize = [INODE_TABLE + inodeIndex * 16 + 2];
            endif;

            if(R9 < 0) then
                [returnAddress] = -1;
            else
                alias lseek R8;
                lseek = OPEN_FILE_TABLE + openFileTableEntry * 4 + 2;

                //checking the validity of the given offset
                if(offset == 0) then
                    [lseek] = 0;
                else
                
                    //lseek greter than disk data structure
                    if([lseek] + offset > fileSize) then
                        [lseek] = fileSize;
                        [returnAddress] = -2;
                    else
                        if([lseek] + offset < 0) then
                            [returnAddress] = -2;
                        else
                            [lseek] = [lseek] + offset;
                            [returnAddress] = 0;
                        endif;
                    endif;
                endif;
            endif;

            //releasing the inode lock
            multipush(R0,R1,R2,R3,R4,R5,R6);
            R1 = RELEASE_INODE;
            R2 = inodeIndex;
            R3 = [SYSTEM_STATUS_TABLE + 1];
            call RESOURCE_MANAGER;
            R9 = R0;
            multipop(R0,R1,R2,R3,R4,R5,R6);

        endif;
    endif;
endif;


[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];

ireturn;