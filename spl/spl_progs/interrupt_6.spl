//read
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 7;

alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = userSP;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias fd R3;

fd =  [([PTBR + 2 * ((userSP - 4 ) / 512)]* 512) + ((userSP - 4) % 512)];


alias physicalAddrRetVal R2;
physicalAddrRetVal = ([PTBR + 2 * ((userSP - 1)/512)] * 512)  + ((userSP-1) % 512);

if(fd != -1) then
    
    //here we are reading from file
    alias perProcessTable R1;
    perProcessTable = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 + RESOURCE_TABLE_OFFSET;
    alias openFileTableEntry R4;
    alias inodeIndex R5;

    if(fd < 0 || fd > 7) then

        [physicalAddrRetVal] = -1;

    else

        if([perProcessTable + 2 * fd] != FILE) then

            [physicalAddrRetVal] = -1;

        else
            
            openFileTableEntry = [perProcessTable + 2 * fd + 1];

            inodeIndex = [OPEN_FILE_TABLE + 4 * openFileTableEntry];

            multipush(R0,R1,R2,R3,R4,R5);
            R1 = ACQUIRE_INODE;
            R2 = inodeIndex;
            R3 = [SYSTEM_STATUS_TABLE + 1];
            call RESOURCE_MANAGER;
            R9 = R0;
            multipop(R0,R1,R2,R3,R4,R5);
            if(R9 == -1) then
                [physicalAddrRetVal] = -1;
            else

                alias lseekPos R6;
                lseekPos = OPEN_FILE_TABLE + 4 * openFileTableEntry + 2;

                alias wordAddr R7;
                wordAddr = [[PTBR + 2 * ((userSP - 3)/512)] * 512 + ((userSP - 3) % 512)];
                wordAddr = [PTBR + 2 * (wordAddr / 512)] * 512 + wordAddr % 512;


                if(inodeIndex == INODE_ROOT) then
                    if([lseekPos] == 480) then //root file size
                        //need to release the inode
                        [physicalAddrRetVal] = -2;
                    else
                        [wordAddr] = [ROOT_FILE + [lseekPos]];
                        [lseekPos] = [lseekPos] + 1;
                        [physicalAddrRetVal] = 0;
                    endif;
                else
                    if([lseekPos] >= [INODE_TABLE + 16 * inodeIndex + 2]) then // End of file reached 
                        //need to release the inode
                        [physicalAddrRetVal] = -2;
                    else

                        //Find the disk block number and the position in the block from which input is read.
                        alias diskBlockNum R8;
                        alias blockOffset R9;
                        diskBlockNum = [INODE_TABLE + inodeIndex * 16 + 8 + ([lseekPos] / 512)];
                        blockOffset = [lseekPos] % 512;

                        //Read the data from the File Buffer by calling the buffered_read() function in the File Manager module.

                        multipush(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);
                        R1 = BUFFERED_READ; //function number 2
                        R2 = diskBlockNum;
                        R3 = blockOffset;
                        R4 = wordAddr; //address to which it should be read
                        call FILE_MANAGER;
                        multipop(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);

                        breakpoint;

                        [lseekPos] = [lseekPos] + 1;

                        [physicalAddrRetVal] = 0;

                    endif;

                endif;

                // Release the Lock on the File by calling the release_inode() function in the Resource Manager module.
                multipush(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);
                R1 = RELEASE_INODE;
                R2 = inodeIndex;
                R3 = [SYSTEM_STATUS_TABLE + 1];
                call RESOURCE_MANAGER;
                multipop(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);
            endif;
        endif;
    endif;
else 

    alias wordAddr R6;
    wordAddr = [[PTBR + 2 * ((userSP - 3)/512)] * 512 + ((userSP - 3) % 512)];
    
    multipush(R0,R1,R2,R3,R4,R5,R6);
    
    alias arg1 R1;
    alias arg2 R2;
    alias arg3 R3;
    arg1 = 4;
    arg2 = [SYSTEM_STATUS_TABLE + 1];
    arg3 = wordAddr;

    call MOD_4;

    
    multipop(R0,R1,R2,R3,R4,R5,R6);
    
    [physicalAddrRetVal] = 0;

endif;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];

ireturn;


