//write
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 5;

alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512;


alias fileDescriptor R1;
fileDescriptor = [[PTBR + 2 * ((userSP - 4 ) / 512)] * 512 + ((userSP - 4) % 512)];

alias physicalAddrRetVal R2;
physicalAddrRetVal = ([PTBR + 2 * ((userSP - 1)/512)] * 512)  + ((userSP-1) % 512);


if(fileDescriptor != -2) then

	///writing into the file

	if(fileDescriptor < 0 || fileDescriptor > 7) then
		[physicalAddrRetVal] = -1;
	else
		alias perProcessTableEntry R3;
		perProcessTableEntry = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 + RESOURCE_TABLE_OFFSET + 2 * fileDescriptor;

		if([perProcessTableEntry + 0] != FILE) then
			[physicalAddrRetVal] = -1;
		else
			alias openFileTableEntry R4;
			openFileTableEntry = [perProcessTableEntry + 1];

			alias inodeIndex R5;
			inodeIndex = [OPEN_FILE_TABLE + 4 * openFileTableEntry + 0];

			alias processTableEntry R6;
			processTableEntry = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;

			if([processTableEntry + 3] != 1 || ([processTableEntry + 3] != [INODE_TABLE + inodeIndex * 16 + 3] && [INODE_TABLE + inodeIndex * 16 + 4] == EXCLUSIVE) ) then
				[physicalAddrRetVal] = -3;
			else
				//acquiring the inode lock;
				multipush(R0,R1,R2,R3,R4,R5,R6);
				R1 = ACQUIRE_INODE;
				R2 = inodeIndex;
				R3 = [SYSTEM_STATUS_TABLE + 1];
				R9 = R0;
				multipop(R0,R1,R2,R3,R4,R5,R6);
				if(R9 < 0 ) then
					[physicalAddrRetVal] = -1;
				else
					alias lseek R7;
					lseek = [OPEN_FILE_TABLE + 4 * openFileTableEntry + 2];
					if(lseek == MAX_FILE_SIZE) then
						//realease the inode
						[physicalAddrRetVal] = -2;
					else
						//If the Lseek position is a multiple of 512 and the same as File size in the inode table	/* New block to be allocated */
						if(lseek% 512 == 0 && lseek == [INODE_TABLE + inodeIndex * 16 + 2]) then
							//allocating new block by calling get free block
							multipush(R0,R1,R2,R3,R4,R5,R6,R7,R8);
							R1 = GET_FREE_BLOCK;
							call MEMORY_MANAGER;
							R9 = R0;
							multipop(R0,R1,R2,R3,R4,R5,R6,R7,R8);

							if(R9 == -1) then
								[physicalAddrRetVal] = -2;
							endif;
							[INODE_TABLE + 16 * inodeIndex + 8 + (lseek / 512)] = R9;

						endif;
						alias diskBlockNum R9;
						diskBlockNum = [INODE_TABLE + 16 * inodeIndex + 8 + (lseek / 512)];

						alias blockOffset R10;
						blockOffset = lseek % 512;

						alias word R11;
						word = [([PTBR + 2 * ((userSP - 3)/512)] * 512) + ((userSP - 3) % 512)];

						if(diskBlockNum != -1) then
							//writing to buffer using buffered write
							multipush(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);
							R1 = BUFFERED_WRITE;
							R2 = diskBlockNum;
							R3 = blockOffset;
							R4 = word;
							call FILE_MANAGER;
							multipop(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);

							// if size was increasesd
							if (lseek == [INODE_TABLE + 16 * inodeIndex + 2]) then
								[INODE_TABLE + 16 * inodeIndex + 2] = [INODE_TABLE + 16 * inodeIndex + 2] + 1;
								[ROOT_FILE + inodeIndex*8 + 1] = [ROOT_FILE + inodeIndex*8 + 1] + 1;
							endif;

							// move file pointer forward
                        	[OPEN_FILE_TABLE + 4 * openFileTableEntry + 2] = [OPEN_FILE_TABLE + 4 * openFileTableEntry + 2] + 1;

							[physicalAddrRetVal] = 0;
						endif;
					endif;
				endif;
				//we will release the acquired inode here
				multipush(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);
				R1 = 5;
				R2 = inodeIndex;
				R3 = [SYSTEM_STATUS_TABLE+1];
				call RESOURCE_MANAGER;
				multipop(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);
			endif;
		endif;
	endif;
else
	//terminal write
	multipush(R0,R1,R2,R3,R4,R5,R6);

	alias terminalWrite R1;
	terminalWrite = 3;

	alias currentPID R2;
	currentPID = [SYSTEM_STATUS_TABLE + 1];

	alias word R3;
	word = [([PTBR + 2 * ((userSP - 3)/512)] * 512) + ((userSP - 3) % 512)];

	
	call MOD_4;
	
	// storing the ret val
	
    [physicalAddrRetVal] = 0;

	multipop(R0,R1,R2,R3,R4,R5,R6);

endif;


exit:

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 13];

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;
