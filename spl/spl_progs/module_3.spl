//FILE_MANAGER

alias functionNum R1;

//buffered write
if(functionNum == 1) then

    alias diskBlockNum R2;
    alias blockOffset R3;
    alias word R4;

    alias bufferNum R5;
    bufferNum = diskBlockNum % MAX_BUFFER;

    // Acquire the buffer by calling the Acquire_Buffer function
    //  in the Resource Manager module;

    multipush(R0,R1,R2,R3,R4,R5);
    R1 = 1;
    R2 = bufferNum;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R0,R1,R2,R3,R4,R5);

    if([BUFFER_TABLE + 4 * bufferNum] != diskBlockNum) then
        if([BUFFER_TABLE + 4 * bufferNum + 1] == 1) then
            //writing back the  contents before replacing
            multipush(R0,R1,R2,R3,R4,R5);
            R1 = 1;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = BUFFER_BASE + bufferNum;
            R4 = [BUFFER_TABLE + bufferNum * 4 + 0];
            call DEVICE_MANAGER;
            multipop(R0,R1,R2,R3,R4,R5);

            [BUFFER_TABLE + 4 * bufferNum + 1] = 0;
        endif;
        //now loading the required block from the disk
        multipush(R0,R1,R2,R3,R4,R5);
        R1 = 2;
        R4 = diskBlockNum;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = BUFFER_BASE + bufferNum;
       
        call DEVICE_MANAGER;
        multipop(R0,R1,R2,R3,R4,R5);

        [BUFFER_TABLE + 4 * bufferNum] = diskBlockNum;
    endif;
    
    [(BUFFER_BASE + bufferNum) * 512 + blockOffset] = word;

    [BUFFER_TABLE + bufferNum*4 + 1] = 1;
    
    //here i am not doing any multipush as we don need the register contents anymore
    //releasing the Buffer
    R1 = 2;
    R2 = bufferNum;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;

    return;

endif;

//buffered read
if(functionNum == 2) then

    alias diskBlockNum R2;
    alias blockOffset R3;
    alias wordLogicalAddr R4;

    alias bufferNum R5;
    bufferNum = diskBlockNum % MAX_BUFFER;

    // Acquire the buffer by calling the Acquire_Buffer function
    //  in the Resource Manager module;


    multipush(R0,R1,R2,R3,R4,R5);
    R1 = 1;
    R2 = bufferNum;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R0,R1,R2,R3,R4,R5);

    if([BUFFER_TABLE + 4 * bufferNum] != diskBlockNum) then
        if([BUFFER_TABLE + 4 * bufferNum + 1] == 1) then
            //writing back the  contents before replacing
            multipush(R0,R1,R2,R3,R4,R5);
            R1 = 1;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = BUFFER_BASE + bufferNum;
            R4 = [BUFFER_TABLE + bufferNum * 4 + 0];
            call DEVICE_MANAGER;
            multipop(R0,R1,R2,R3,R4,R5);

            [BUFFER_TABLE + 4 * bufferNum + 1] = 0;
        endif;
        //now loading the required block from the disk
        multipush(R0,R1,R2,R3,R4,R5);
        R1 = 2;
        R4 = diskBlockNum;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = BUFFER_BASE + bufferNum;
       
        call DEVICE_MANAGER;
        multipop(R0,R1,R2,R3,R4,R5);

        [BUFFER_TABLE + 4 * bufferNum] = diskBlockNum;
    endif;
    
    [wordLogicalAddr]  = [(BUFFER_BASE + bufferNum) * 512 + blockOffset];
    
    //releasing the Buffer
    //here i am not doing any multipush as we don need the register contents anymore
    R1 = 2;
    R2 = bufferNum;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;

    return;

endif;

//open
if(functionNum == 3) then
    alias fileName R2;

    alias inodeEntry R3;
    inodeEntry = 0;
    while(inodeEntry < MAX_FILE_NUM) do
        if([INODE_TABLE + inodeEntry * 16 + 1] == fileName) then
            break;
        endif;
        inodeEntry = inodeEntry + 1;
    endwhile;

    if(inodeEntry == MAX_FILE_NUM) then
        R0 = -1;
        return;
    endif;

    //accquire inode
    multipush(R1,R2,R3);
    R1 = 4;
    R2 = inodeEntry;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3);

    if(R0 < 0) then
        return; // Only data files can be opened
    endif;

    if([INODE_TABLE + inodeEntry * 16] == EXEC) then
        //release inode
        multipush(R1,R2,R3);
        R1 = 5;
        R2 = inodeEntry;
        R3 = [SYSTEM_STATUS_TABLE + 1];
        call RESOURCE_MANAGER;
        multipop(R1,R2,R3);
        R0 = -1;
        return;
    endif;

    //find free entry in the open file table

    alias entry R4;
    entry = 0;
    while(entry < MAX_OPENFILE_NUM) do
        if([OPEN_FILE_TABLE + entry * 4] == -1) then
            break;
        endif;
        entry = entry + 1;
    endwhile;

    if(entry == MAX_OPENFILE_NUM) then
        R0 = -2;
        return;
    endif;

    if(fileName == "root") then
        [OPEN_FILE_TABLE + entry * 4] = INODE_ROOT;
    else
        if([FILE_STATUS_TABLE + inodeEntry * 4 + 1] == -1) then
            [FILE_STATUS_TABLE + inodeEntry * 4 + 1] = 1;
        else
            [FILE_STATUS_TABLE + inodeEntry * 4 + 1] = [FILE_STATUS_TABLE + inodeEntry * 4 + 1] + 1;
        endif;
            [OPEN_FILE_TABLE + entry * 4] = inodeEntry;
    endif;

    [OPEN_FILE_TABLE + entry * 4 + 1] = 1;
    [OPEN_FILE_TABLE + entry * 4 + 2] = 0;

    //release inode
    multipush(R1,R2,R3,R4);
    R1 = 5;
    R2 = inodeEntry;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4);

    R0 = entry;

    return;

endif;

//close
if(functionNum == 4) then
    alias fileTableIdx R2;

    alias inodeIndex R3;
    inodeIndex = [OPEN_FILE_TABLE + fileTableIdx * 4];

    [OPEN_FILE_TABLE + 4 * fileTableIdx + 1] = [OPEN_FILE_TABLE + 4 * fileTableIdx + 1] - 1;

    //if no one is using the file
    if([OPEN_FILE_TABLE + 4 * fileTableIdx + 1] == 0) then
        [OPEN_FILE_TABLE + 4 * fileTableIdx] = -1;
        [OPEN_FILE_TABLE + 4 * fileTableIdx + 1] = -1;

        //if the file is not root we decrement the count in file status table
        if(inodeIndex != INODE_ROOT) then
            [FILE_STATUS_TABLE + inodeIndex * 4 + 1] = [FILE_STATUS_TABLE + inodeIndex * 4 + 1] - 1;
        endif;
        if([FILE_STATUS_TABLE + inodeIndex * 4 + 1] == 0) then
            [FILE_STATUS_TABLE + inodeIndex * 4 + 1] = -1;
        endif;
    endif;

    return;
endif;

return;