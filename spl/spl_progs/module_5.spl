//Scheduler

alias currentPID R1;

currentPID = [SYSTEM_STATUS_TABLE+1];

multipush(BP);

alias process_table_entry R2;
process_table_entry = PROCESS_TABLE + currentPID * 16;

[process_table_entry + 12] = SP % 512;
[process_table_entry + 14] = PTBR;
[process_table_entry + 15] = PTLR;

//-----------getting a new process

alias newPID R3;

// alias i R4;
// i = 0;
// print "start";
// while(i<16) do
//     print [PROCESS_TABLE + i*16 + 4];
//     i = i + 1;
// endwhile;
// print "end";

if([SYSTEM_STATUS_TABLE + 5] == 1) then
    if([PROCESS_TABLE + 15 * 16 + 4] == WAIT_DISK) then
        newPID = 0;
    else
        newPID = SWAPPER_DAEMON;
    endif;
else
    newPID = currentPID + 1;
    while(newPID < MAX_PROC_NUM - 1) do
        if(([PROCESS_TABLE + newPID*16 + 4] == READY || [PROCESS_TABLE + newPID*16 + 4] == CREATED ) && [PROCESS_TABLE + newPID * 16 + 6] != 1) then
            break;
        endif;
        newPID = newPID + 1;
    endwhile;
    if(newPID >= MAX_PROC_NUM - 1) then
        newPID = 0;
    endif;
endif;


//-----------found a new Process ^

//restoring the sp,ptbr and ptlr
alias new_process_table R4;
new_process_table = PROCESS_TABLE + newPID * 16;

//Set back Kernel SP, PTBR , PTLR
SP =  [new_process_table + 11] * 512 + [new_process_table + 12];
PTBR = [new_process_table + 14];
PTLR = [new_process_table + 15];

//new proccess
[SYSTEM_STATUS_TABLE + 1] = newPID;

if([new_process_table + 4] == CREATED) then
	[new_process_table + 4] = RUNNING;
	SP = [new_process_table + 13];
    BP = [[new_process_table + 11] * 512];

    [new_process_table + 9] = 0; //mode flag
	ireturn;
endif;

[new_process_table + 4] = RUNNING;

multipop(BP);

return;
