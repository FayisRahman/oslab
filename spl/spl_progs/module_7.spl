//initialising disk status table
[DISK_STATUS_TABLE + 0] = 0;


//initializing Terminal status table

[TERMINAL_STATUS_TABLE + 0] = 0;

//setting process table state to terminated
alias i R0;
i = 0;
while(i<16) do
    [PROCESS_TABLE + 16*i + 4] = TERMINATED;
    [PROCESS_TABLE + 16*i] = 0;
    i = i + 1;
endwhile;

//initialising memory free list

//as effective free page start from 78 (we used some for idle and init process) and upto 127
i = 0;

while(i < NUM_MEM_PAGES) do
    if(i < 81) then
        [MEMORY_FREE_LIST + i] = 1;
    else
        [MEMORY_FREE_LIST + i] = 0;
    endif;
    i = i + 1;
endwhile;

alias processTable R1;

//initialising system status table

[SYSTEM_STATUS_TABLE + 2] = 45;
[SYSTEM_STATUS_TABLE + 3] = 0;
[SYSTEM_STATUS_TABLE + 4] = 0;
[SYSTEM_STATUS_TABLE + 5] = 0;

//init_page_Table
PTBR = PAGE_TABLE_BASE+20;
PTLR = 10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";
//Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";
//Stack
[PTBR+16] = 66;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

processTable = PROCESS_TABLE + 16;

[processTable + 1] = 1;       //pid_for_init
[processTable + 3] = 1;       //init_process_gets_Scheduled_first
[processTable + 4] = CREATED;
[processTable + 11] = 77;     //user_area_page
[processTable + 12] = 0;     //KPTR_for_init
[processTable + 13] = 8*512; //UPTR_for_init
[processTable + 14] = PTBR;   //PTBR_for_init
[processTable + 15] = PTLR;   //PTLR_for_init

[66 * 512] = [65 * 512 + 1];


//initialising per process table of init process
alias perProcessTable R2;
perProcessTable = ([processTable + 11] + 1) * 512 - 16;

i=0;
while(i<16) do
    [perProcessTable + i] = -1;
    i = i + 1;
endwhile;


//shell_page_Table

PTBR = PAGE_TABLE_BASE+40;
PTLR = 10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";
//Code
[PTBR+8] = 67;
[PTBR+9] = "0100";
[PTBR+10] = 68;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";
//Stack
[PTBR+16] = 78;
[PTBR+17] = "0110";
[PTBR+18] = 79;
[PTBR+19] = "0110";

processTable = PROCESS_TABLE + 32;

[processTable + 1] = 2;           //pid_for_shell
[processTable + 2] = 1;           //ppid
[processTable + 3] = 2;           //pid
[processTable + 4] = TERMINATED;
[processTable + 11] = 80;         //user_area_page
[processTable + 12] = 0;          //KPTR_for_init
[processTable + 13] = 8*512;     //UPTR_for_init
[processTable + 14] = PTBR;       //PTBR_for_init
[processTable + 15] = PTLR;       //PTLR_for_init


[78 * 512 ] = [67 * 512 + 1];

//initialising disk map table for shell

i=0;
alias diskMapTable R1;
diskMapTable = DISK_MAP_TABLE + 10 * 2;
while(i<10) do
    if(i>=4 && i < 6) then
        [diskMapTable + i] = [PTBR + i * 2];
    else
        [diskMapTable + i] = -1;
    endif;
    i = i + 1;
endwhile;

//initializing semaphore table entry
i=0;
while(i<MAX_SEM_COUNT) do
    [SEMAPHORE_TABLE + 4 * i] = -1;
    [SEMAPHORE_TABLE + 4 * i + 1] = 0;
    i = i + 1;
endwhile;

//initializing file status table
i=0;
while(i < MAX_FILE_NUM) do
    [FILE_STATUS_TABLE + 4 * i] = -1;
    [FILE_STATUS_TABLE + 4 * i + 1] = -1;
    i = i + 1;
endwhile;

//initialising buffer table
i=0;
while(i < MAX_BUFFER) do
    [BUFFER_TABLE + 4 * i] = -1;
    [BUFFER_TABLE + 4 * i + 1] = 0;
    [BUFFER_TABLE + 4 * i + 2] = -1;
    i = i + 1;
endwhile;

//initiliasing open file table
i=0;
while(i < MAX_BUFFER) do
   [OPEN_FILE_TABLE + i * 4 + 0] = -1;
    [OPEN_FILE_TABLE + i * 4 + 1] = 0;
    i = i + 1;
endwhile;

return;